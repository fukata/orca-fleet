    "worker_log": os.path.join(_STATE_DIR, "worker.log"),
}
SETTINGS = {"app_stop_timeout_seconds": 30, "safe_idle_seconds": 120, "verify_timeout_seconds": 180,
            "stability_seconds": 15, "min_free_mb": 1024, "install_timeout_seconds": 600}
