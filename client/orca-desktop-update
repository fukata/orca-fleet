_LOCALAPPDATA = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~/AppData/Local")
_INSTALL_DIR = os.path.join(_LOCALAPPDATA, "Programs", "orca")
_STATE_DIR = os.path.join(os.path.expanduser("~"), ".local", "state", "orca-desktop-update")
PATHS = {
